# ── Authentication & LLM Provider ──────────────────────────────────────────────
# Active LLM provider: "gemini" (or "vertex_ai") | "openai" | "anthropic" | "auto"
# Controls authentication routing and default model architectures.
RAG_LLM_PROVIDER="gemini"

# --- Option A: Google Cloud Application Default Credentials (ADC) [RECOMMENDED] ---
# No API key needed! Authenticate seamlessly via Google Cloud CLI:
#   gcloud auth application-default login
# The system automatically detects ~/.config/gcloud/application_default_credentials.json,
# manages 1-hour OAuth2 token lifetimes, and executes high-performance Vertex AI calls.
GOOGLE_CLOUD_PROJECT="gleaming-vision-509507-j6"
GOOGLE_CLOUD_LOCATION="us-central1"

# --- Option B: Direct Gemini API Key (Alternative) ---
# Set if not using Google Cloud ADC:
# GEMINI_API_KEY="your-gemini-api-key-here"

# --- Option C: OpenAI API Key (Alternative) ---
# Set if RAG_LLM_PROVIDER=openai:
# OPENAI_API_KEY="sk-your-openai-api-key-here"

# SEC EDGAR fair-use policy requires a user-agent with your name and email
SEC_USER_AGENT="Your Name your@email.com"

# ── Infrastructure ──────────────────────────────────────────────────────────────
# Qdrant vector database URL (local Docker default shown)
QDRANT_URL="http://localhost:6333"

# Redis URL for semantic cache / rate limiting (optional, falls back to in-memory)
# REDIS_URL="redis://localhost:6379/0"

# Maximum concurrent outbound LLM API requests (bounds rate limits and cost spikes)
# RAG_OPENAI_MAX_CONCURRENCY=10

# Semantic cache TTL in hours
# RAG_CACHE_TTL_HOURS=24

# ── Gemini Model Configuration (defaults when RAG_LLM_PROVIDER=gemini) ──────────
# Generation: high-capability model for deep financial reasoning & SEC accuracy
# RAG_GENERATION_MODEL="gemini/gemini-2.5-pro"
# RAG_GENERATION_TEMPERATURE=0.1
# RAG_GENERATION_MAX_CONTEXT_TOKENS=8192

# Query Router & Transformation: fast, cost-efficient model for classification
# RAG_QUERY_ROUTER_MODEL="gemini/gemini-2.0-flash"
# RAG_QUERY_TRANSFORM_MODEL="gemini/gemini-2.0-flash"

# Embeddings: Gemini text-embedding-004 (768-dim)
# NOTE: If you change the embedding model, you MUST re-ingest all documents.
#       The Qdrant collection vector dimension must match the embedding output size.
# RAG_EMBEDDING_MODEL="gemini/text-embedding-004"
# RAG_EMBEDDING_VECTOR_DIM=768

# Knowledge Graph extraction
# RAG_KG_EXTRACTION_MODEL="gemini/gemini-2.0-flash"

# Evaluation LLM-as-a-judge
# RAG_EVAL_MODEL="gemini/gemini-2.5-pro"

# ── OpenAI Model Configuration (use when RAG_LLM_PROVIDER=openai) ───────────────
# RAG_GENERATION_MODEL="gpt-5"
# RAG_GENERATION_TEMPERATURE=0.1
# RAG_QUERY_ROUTER_MODEL="gpt-5-mini"
# RAG_QUERY_TRANSFORM_MODEL="gpt-5-mini"
# RAG_EMBEDDING_MODEL="text-embedding-3-small"
# RAG_EMBEDDING_VECTOR_DIM=1536
# RAG_KG_EXTRACTION_MODEL="gpt-5-mini"
# RAG_EVAL_MODEL="gpt-5-mini"

# ── Pipeline Configuration ───────────────────────────────────────────────────────
# RAG_GENERATION_STRICT_VERIFICATION=false
# RAG_GENERATION_ABSTENTION_THRESHOLD=0.50
# RAG_GENERATION_REFLEXION_ENABLED=true
# RAG_GENERATION_MAX_REFLEXION_ATTEMPTS=1
# RAG_CONTEXT_MMR_THRESHOLD=0.92

# RAG_QUERY_ROUTER_FAST_PATH_ENABLED=true
# RAG_QUERY_TRANSFORM_HYDE_ENABLED=true
# RAG_QUERY_TRANSFORM_MULTIQUERY_ENABLED=true
# RAG_QUERY_TRANSFORM_STEPBACK_ENABLED=true
# RAG_QUERY_TRANSFORM_CACHE_SIZE=256

# Multi-representation & Late-interaction retrieval
# RAG_RETRIEVAL_TOP_K_DENSE=20
# RAG_RETRIEVAL_TOP_K_BM25=25
# RAG_RETRIEVAL_TOP_K_COLBERT=15
# RAG_RETRIEVAL_TOP_K_FINAL=8
# RAG_RETRIEVAL_RRF_K=60
# RAG_COLBERT_ENABLED=true
# RAG_RERANKER_ENABLED=true
# RAG_RERANKER_MODEL="ms-marco-MiniLM-L-12-v2"

# Knowledge Graph (GraphRAG) entity-relation extraction and multi-hop retrieval
# RAG_KG_RETRIEVAL_ENABLED=true
# RAG_KG_EXTRACTION_ENABLED=true

# ── Evaluation & Ablations ──────────────────────────────────────────────────────
# RAG_EVAL_SAMPLE_SIZE=50

# ── Observability & Telemetry ───────────────────────────────────────────────────
# Distributed tracing & per-query audit logs
# RAG_TRACING_ENABLED=true
# RAG_TRACING_PERSIST=true
# RAG_AUDIT_ENABLED=true
# RAG_AUDIT_LOG_DIR="logs/audit"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Grafana admin password for docker-compose monitoring stack
# GRAFANA_ADMIN_PASSWORD="changeme"

# ── Logging ─────────────────────────────────────────────────────────────────────
# Log format ('text' for local dev, 'json' for Docker/Kubernetes/ELK production)
LOG_FORMAT="text"
