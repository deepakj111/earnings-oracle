# ── Required ────────────────────────────────────────────────────────────────────
# OpenAI API key — used by query transformation, generation, evaluation, CRAG grading
OPENAI_API_KEY="sk-your-openai-api-key-here"

# SEC EDGAR fair-use policy requires a user-agent with your name and email
SEC_USER_AGENT="Your Name your@email.com"

# ── Infrastructure ──────────────────────────────────────────────────────────────
# Qdrant vector database URL (local Docker default shown)
QDRANT_URL="http://localhost:6333"

# ── Optional: CRAG Web Search Fallback ──────────────────────────────────────────
# Tavily API key for web search fallback in CRAG layer (optional)
# Get a free key at https://tavily.com
# TAVILY_API_KEY="your_tavily_api_key_here"

# ── Optional: Observability ─────────────────────────────────────────────────────
# Grafana admin password for the docker-compose monitoring stack
# GRAFANA_ADMIN_PASSWORD="changeme"

# ── Optional: Log format ('text' for dev, 'json' for Docker/K8s) ───────────────
# LOG_FORMAT="text"
